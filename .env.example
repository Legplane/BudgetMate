# Neon connection string (use the POOLED one, host contains "-pooler")
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Long random string, e.g. run: openssl rand -hex 32
JWT_SECRET=
# Optional: timezone used for "today" (default Asia/Manila)
# APP_TZ=Asia/Manila
# Optional: set true to create the demo account (off by default in production)
# SEED_DEMO=false
