{
  "name": "budgetmate",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:server:dev\" \"vite\"",
    "server": "node --env-file-if-exists=.env server/index.js",
    "server:dev": "node --env-file-if-exists=.env --watch server/index.js",
    "build": "vite build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/index.js",
    "preview": "vite preview",
    "test": "NODE_ENV=test node --test server/test/api.test.js",
    "seed": "node --env-file-if-exists=.env -e \"import('./server/seed.js').then(m=>m.seedDemo()).then(()=>process.exit(0))\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.383.0",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^10.0.7",
    "tailwindcss": "^4.0.0",
    "vite": "^5.4.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
